# Copia este archivo como .env y completa los valores.

# Conexion a la base de datos (obligatoria)
#   SQLite local:  sqlite:///plan_contable.db
#   PostgreSQL:    postgresql://usuario:clave@localhost:5432/plan_contable
DATABASE_URL=sqlite:///plan_contable.db

# Clave para firmar las sesiones (opcional en local; obligatoria en produccion).
# Si se deja vacia, el sistema genera una y la guarda en la base de datos.
SECRET_KEY=

# Token de apis.net.pe para consultar RUC y tipo de cambio (opcional).
APIS_NET_PE_TOKEN=

# Puerto del servidor de desarrollo (opcional, por defecto 5000).
PORT=5000
